@{
    ViewBag.Title = "Acceso Denegado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card mt-5">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Acceso Denegado</h4>
                </div>
                <div class="card-body text-center">
                    <h5>No tienes permisos para acceder a esta página</h5>
                    <p>Contacta al administrador del sistema si necesitas acceso.</p>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Volver al Inicio</a>
                    <a href="@Url.Action("Index", "Login")" class="btn btn-outline-secondary">Iniciar Sesión</a>
                </div>
            </div>
        </div>
    </div>
</div>
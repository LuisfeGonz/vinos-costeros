<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Sistema VC</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <div class="navbar navbar-inverse">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                @Html.ActionLink("Sistema VC", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            </div>
            <div class="navbar-collapse collapse">
                @{
                    var currentController = ViewContext.RouteData.Values["controller"].ToString();
                }

                <ul class="nav navbar-nav">
                    <li class="@(currentController == "Rols" ? "active" : "")">@Html.ActionLink("Roles", "Index", "Rols")</li>
                    <li class="@(currentController == "Usuarios" ? "active" : "")">@Html.ActionLink("Usuarios", "Index", "Usuarios")</li>
                    @*<li class="@(currentController == "Rankings" ? "active" : "")">@Html.ActionLink("Rankings", "Index", "Rankings")</li>*@
                    <li class="@(currentController == "Parcelas" ? "active" : "")">@Html.ActionLink("Parcelas", "Index", "Parcelas")</li>
                    <li class="@(currentController == "Produccions" ? "active" : "")">@Html.ActionLink("Producción", "Index", "Produccions")</li>
                    <li class="@(currentController == "Siembras" ? "active" : "")">@Html.ActionLink("Siembras", "Index", "Siembras")</li>
                    <li class="@(currentController == "ControlSiembras" ? "active" : "")">@Html.ActionLink("Control de Siembras", "Index", "ControlSiembras")</li>
                    <li class="@(currentController == "FaseProduccions" ? "active" : "")">@Html.ActionLink("Fases de Producción", "Index", "FaseProduccions")</li>
                    <li class="@(currentController == "Catas" ? "active" : "")">@Html.ActionLink("Catas", "Index", "Catas")</li>
                </ul>

            </div>
        </div>
    </div>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Sistema VC</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>

@model IEnumerable<SistemaVC_VinosCosteros.Models.cata>

@{
    ViewBag.Title = "Índice";
}

<h2>Índice</h2>

<p>
    @Html.ActionLink("Crear nuevo", "Create")
</p>
<div class="table-responsive">
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.fecha)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.observaciones)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.calificacion)
            </th>
            <th>
                producción
            </th>
            @*<th>
                    ranking
                </th>*@
            <th>
                evaluador
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.fecha)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.observaciones)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.calificacion)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.produccion.nombre)
                </td>
                @*<td>
                        @Html.DisplayFor(modelItem => item.ranking.nombre)
                    </td>*@
                <td>
                    @Html.DisplayFor(modelItem => item.usuario.nombre)
                </td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = item.id }) |
                    @Html.ActionLink("Detalle", "Details", new { id = item.id }) |
                    @Html.ActionLink("Eliminar", "Delete", new { id = item.id })
                </td>
            </tr>
        }

    </table>
</div>

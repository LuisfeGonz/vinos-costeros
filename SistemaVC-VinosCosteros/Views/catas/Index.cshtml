@model IEnumerable<SistemaVC_VinosCosteros.Models.cata>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.fecha)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.observaciones)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.idEvaluador)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.idProduccion)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.idRanking)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.fecha)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.observaciones)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.idEvaluador)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.idProduccion)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.idRanking)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.id }) |
            @Html.ActionLink("Details", "Details", new { id=item.id }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.id })
        </td>
    </tr>
}

</table>

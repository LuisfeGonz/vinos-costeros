<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="VinosCosterosModelStoreContainer" CdmEntityContainer="VinosCosterosEntities">
    <EntitySetMapping Name="rols">
      <EntityTypeMapping TypeName="VinosCosterosModel.rol">
        <MappingFragment StoreEntitySet="rol">
          <ScalarProperty Name="estatus" ColumnName="estatus" />
          <ScalarProperty Name="descripcion" ColumnName="descripcion" />
          <ScalarProperty Name="nombre" ColumnName="nombre" />
          <ScalarProperty Name="id" ColumnName="id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="usuarios">
      <EntityTypeMapping TypeName="VinosCosterosModel.usuario">
        <MappingFragment StoreEntitySet="usuario">
          <ScalarProperty Name="estatus" ColumnName="estatus" />
          <ScalarProperty Name="contrasenia" ColumnName="contrasenia" />
          <ScalarProperty Name="email" ColumnName="email" />
          <ScalarProperty Name="rol" ColumnName="rol" />
          <ScalarProperty Name="apellido" ColumnName="apellido" />
          <ScalarProperty Name="nombre" ColumnName="nombre" />
          <ScalarProperty Name="id" ColumnName="id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="catas">
      <EntityTypeMapping TypeName="VinosCosterosModel.cata">
        <MappingFragment StoreEntitySet="cata">
          <ScalarProperty Name="idRanking" ColumnName="idRanking" />
          <ScalarProperty Name="idProduccion" ColumnName="idProduccion" />
          <ScalarProperty Name="idEvaluador" ColumnName="idEvaluador" />
          <ScalarProperty Name="observaciones" ColumnName="observaciones" />
          <ScalarProperty Name="fecha" ColumnName="fecha" />
          <ScalarProperty Name="id" ColumnName="id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="rankings">
      <EntityTypeMapping TypeName="VinosCosterosModel.ranking">
        <MappingFragment StoreEntitySet="ranking">
          <ScalarProperty Name="descripcion" ColumnName="descripcion" />
          <ScalarProperty Name="nombre" ColumnName="nombre" />
          <ScalarProperty Name="id" ColumnName="id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
  </EntityContainerMapping>
</Mapping>